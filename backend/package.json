{
  "name": "ioc-scanner-backend",
  "version": "1.0.0",
  "description": "API REST del IOC Scanner: reputacion de IPs, hashes y dominios contra fuentes de threat intelligence.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  }
}
