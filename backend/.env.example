# ---------------------------------------------------------------------------
# IOC Scanner - backend
# Copia este archivo a `.env` y rellena los valores. NUNCA commitees `.env`.
# Todos los valores aqui son placeholders, no credenciales reales.
# ---------------------------------------------------------------------------

# Puerto HTTP del servidor
PORT=3000

# Interfaz de red donde escucha. 127.0.0.1 (default) = solo esta maquina.
# Ponerlo en 0.0.0.0 expone la API (y la cuota real de las fuentes externas)
# a toda la red local -- solo cambialo si sabes que lo necesitas.
HOST=127.0.0.1

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Fuentes de threat intelligence
# ---------------------------------------------------------------------------

# true  -> respuestas simuladas, deterministas, sin red ni API keys (DEFAULT)
# false -> llamadas reales; exige las API keys de abajo o el arranque falla
USE_MOCK_SOURCES=true

# Presupuesto de tiempo por llamada saliente a una fuente (ms).
# Agotarlo produce un reporte degradado, nunca cuelga el request.
SOURCE_TIMEOUT_MS=5000

# Requeridas solo si USE_MOCK_SOURCES=false
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# URLhaus (abuse.ch): desde la politica "Community First" de abuse.ch
# (2024-2025), la Host API EXIGE un Auth-Key gratuito -- sin el, la API
# responde 401 y la fuente se degrada a "unavailable". Sacala gratis en
# https://auth.abuse.ch/. El codigo la sigue tratando como opcional (no
# rompe el arranque si falta) para no acoplar el arranque del servidor a un
# tercero, pero en la practica hoy es obligatoria para que URLhaus funcione.
URLHAUS_AUTH_KEY=

# ---------------------------------------------------------------------------
# Cuota diaria (solo aplica con USE_MOCK_SOURCES=false)
#
# Limites del TIER GRATUITO publicados por cada proveedor. Si el proveedor
# cambia estos numeros algun dia, se actualizan aca -- son solo el punto de
# partida: AbuseIPDB se reconcilia en cada respuesta con sus propios headers
# (X-RateLimit-Limit/Remaining/Reset), que son la fuente de verdad real.
# VirusTotal no expone remanente por header de forma confiable, asi que su
# limite vive SOLO en este numero mas el contador propio que persiste el
# tracker en `backend/data/quota-state.json`.
# URLhaus no tiene limite publicado ni exige API key: nunca se bloquea, solo
# se cuenta su uso para informar (ver GET /api/quota).
# ---------------------------------------------------------------------------

# AbuseIPDB, plan gratuito: 1000 checks/dia (verificado en su documentacion).
ABUSEIPDB_DAILY_LIMIT=1000

# VirusTotal, API publica gratuita: ~500 requests/dia (4/min).
VIRUSTOTAL_DAILY_LIMIT=500

# ---------------------------------------------------------------------------
# Valores de demostracion en modo mock
#
# Estos valores dan SIEMPRE el mismo veredicto, para poder probar los tres
# estados de la mascota del frontend. Cualquier otro valor recibe un veredicto
# derivado del propio valor: determinista, pero no elegido a mano.
#
#   clean       192.0.2.1 | e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 | ejemplo.com
#   suspicious  198.51.100.14 | da39a3ee5e6b4b0d3255bfef95601890afd80709 | sospechoso.example
#   malicious   203.0.113.66 | 44d88612fea8a8f36de82e1278abb02f | malicious.example
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Historial
# ---------------------------------------------------------------------------

# Maximo de scans retenidos en memoria; al superarlo se descartan los mas viejos.
HISTORY_MAX_ENTRIES=200

# Tope de `?limit=` en GET /api/history
HISTORY_MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Origenes permitidos por CORS, separados por coma. Sin comodines.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting: ventana en ms y maximo de requests por IP en esa ventana.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
